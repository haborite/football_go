{
  "name": "go-football",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "囲碁サッカー — サッカーボール型の碁盤球で打つ純碁",
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/server.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/server.ts",
    "test": "tsx src/shared/selftest.ts",
    "test:npc": "tsx src/shared/npctest.ts",
    "test:e2e": "tsx src/server/e2etest.ts",
    "test:browser": "node scripts/browsertest.mjs",
    "ogp": "tsx scripts/ogpimage.ts"
  },
  "dependencies": {
    "three": "^0.169.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.0.0",
    "playwright": "^1.60.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
